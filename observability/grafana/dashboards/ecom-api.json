  "panels": [
    {
      "type": "row",
      "title": "SLO",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Requêtes sous 300 ms (SLO)",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(http_server_requests_seconds_bucket{application=\"ecom\", uri!~\"/actuator.*\", le=\"0.3\"}[$__range])) / sum(rate(http_server_requests_seconds_count{application=\"ecom\", uri!~\"/actuator.*\"}[$__range]))",
          "legendFormat": "__auto",
          "refId": "A",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0.95
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {},
      "description": "Part des requêtes servies en moins de 300 ms sur la période affichée."
    },
    {
      "type": "stat",
      "title": "Latence p95",
